# BhashaSetu AI Environment Configuration (Production & Online Deployment)

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Pipeline Mode (online / offline)
PIPELINE_MODE=online

# ASR Provider (sarvam / mock)
ASR_PROVIDER=sarvam
ASR_API_KEY=your_sarvam_api_key_here

# Translation Engine (sarvam / mock)
TRANSLATION_PROVIDER=sarvam
TRANSLATION_API_KEY=your_sarvam_api_key_here
TRANSLATION_API_URL=https://api.sarvam.ai/translate

# TTS Provider (sarvam / bhashini / mock)
TTS_PROVIDER=bhashini
TTS_API_KEY=your_bhashini_api_key_here
TTS_USER_ID=your_bhashini_user_id_here
TTS_SERVICE_ID=bhashini/v1/tts/sat

# Gemini AI (Textbook Scanner OCR & Worksheet Generation)
GEMINI_API_KEY=your_gemini_api_key_here
